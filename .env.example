# Weg A (Standard): SQLite als Datei. Nichts weiter nötig.
PORT=3000
SQLITE_FILE=data/site.db

# Cockpit unter /admin/ — ohne Passwort ist keine Anmeldung möglich.
# Keine Zugangsdaten im Code, nur hier (diese Datei heißt dann .env und bleibt im .gitignore).
ADMIN_PASSWORD=

# Weg B / C: sobald DATABASE_URL gesetzt ist, schaltet src/db.js von allein auf Postgres um.
# Echte Werte nur in der Umgebung des Hosters — nie ins Repository, nie in einen Chat.
# DATABASE_URL=postgres://benutzer:passwort@host:5432/datenbank

# Stufe 4 — der Generator (KI als Motor). Schlüssel von console.anthropic.com, nur hier eintragen.
# Ohne Schlüssel läuft alles andere weiter; nur „Generieren" im Cockpit meldet, dass er fehlt.
ANTHROPIC_API_KEY=
# Optional: ein anderes Modell. Standard ist claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5
# Optional, für Tests oder ein anderes Sprachmodell: ein Modul, das statt der Anthropic-API antwortet.
# Es exportiert als default eine Funktion ({ system, user }) => Text oder { text, verbrauch }.
# GENERATOR_MODUL=./pfad/zum/modul.js
